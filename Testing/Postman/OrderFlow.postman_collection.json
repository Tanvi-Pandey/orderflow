      "name": "Order APIs",
      "item": [
        {
          "name": "Create Buy Order",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"symbol\": \"TCS\",\n    \"side\": \"BUY\",\n    \"type\": \"LIMIT\",\n    \"price\": 3200,\n    \"quantity\": 15\n  }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/orders",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "8080",
              "path": [
                "orders"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Request completed successfully\", function () {",
                  "    pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        },
